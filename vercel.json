{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.css)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.js)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.png)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.jpg)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.ico)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.xml)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.txt)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
